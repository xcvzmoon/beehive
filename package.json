{
  "name": "beehive",
  "version": "0.0.1",
  "description": "Composable AI inference API built on Nitro",
  "type": "module",
  "scripts": {
    "build": "nitro build",
    "dev": "nitro dev",
    "preview": "nitro preview",
    "prepare": "vp config",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "release:patch": "changelogen --patch --release && git push --follow-tags",
    "release:minor": "changelogen --minor --release && git push --follow-tags",
    "release:major": "changelogen --major --release && git push --follow-tags",
    "release:dry": "changelogen --dry",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:seed:catalog": "node scripts/seed-provider-catalog.mjs",
    "db:sync:ollama-models": "node scripts/sync-ollama-models.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "ai": "^6.0.208",
    "better-auth": "^1.6.20",
    "drizzle-orm": "1.0.0-beta.22",
    "drizzle-query-logger": "^1.1.2",
    "handlebars": "^4.7.9",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "unemail": "^0.5.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "drizzle-kit": "1.0.0-beta.22",
    "h3": "2.0.1-rc.22",
    "nitro": "latest",
    "typescript": "7.0.1-rc",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.8.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.8.0"
}
